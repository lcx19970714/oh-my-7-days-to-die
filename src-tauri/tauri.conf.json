{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WastelandModManager",
  "version": "0.1.0",
  "identifier": "com.wasteland.modmanager",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:47183",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "七日杀 Mod 管家",
        "width": 1240,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "decorations": false,
        "shadow": true,
        "dragDropEnabled": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "七日杀 Mod 管家",
    "longDescription": "本地管理《七日杀》模组：扫描、启停、安装、配置档、备份与启动游戏。",
    "copyright": "Copyright © 2026"
  }
}
